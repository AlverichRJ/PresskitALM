---
import GalleryGrid from '../interactive/GalleryGrid';
---
<section id="galeria" class="scene-section gallery-section">
  <div class="section-shell gallery-section__shell">
    <p class="eyebrow">Galería</p>
    <h2 class="cinematic-title gallery-section__title">Momentos que vale la pena recordar</h2>
    <p class="gallery-section__lead">No recordamos todos los ensayos, pero sí los momentos que compartimos con el público</p>

    <div class="gallery-section__grid-wrap">
      <GalleryGrid client:visible />
    </div>
  </div>
</section>

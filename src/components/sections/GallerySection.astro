---
import GalleryGrid from '../interactive/GalleryGrid';
---
<section id="galeria" class="scene-section">
  <div class="section-shell">
    <p class="eyebrow">Galería</p>
    <h2 class="cinematic-title mt-4 max-w-4xl text-6xl md:text-8xl">Backstage, escenario y presencia</h2>
    <p class="mt-8 max-w-2xl text-lg leading-8 text-smoke">Estructura preparada para sustituir placeholders por fotografías oficiales, material de conciertos y press shots optimizados.</p>
    <div class="mt-14">
      <GalleryGrid client:visible />
    </div>
  </div>
</section>

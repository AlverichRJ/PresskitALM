---
import band from '../../content/band.json';

const assetPath = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
---
<section id="inicio" class="hero-cinematic relative grid min-h-screen place-items-center overflow-hidden bg-black px-6 py-24">
  <div class="absolute inset-0 bg-cover bg-center opacity-60" style={`background-image: url('${assetPath('/images/hero/hero-placeholder.svg')}')`}></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(199,58,14,0.18),transparent_28rem),linear-gradient(180deg,rgba(0,0,0,0.45)_0%,rgba(0,0,0,0.76)_52%,#070707_100%)]"></div>
  <div class="absolute left-1/2 top-1/2 h-[42rem] w-[42rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-ember/10 blur-3xl"></div>
  <div class="hero-vignette absolute inset-0"></div>

  <div class="relative z-10 mx-auto flex max-w-6xl flex-col items-center text-center">
    <div class="brand-fusion" aria-label="Al-Maburak">
      <img
        src={assetPath('/brand/almaburak-emblema-cuervo.webp')}
        alt="Emblema de Al-Maburak con ave y rayo"
        class="brand-fusion__emblem"
        width="1560"
        height="1080"
        loading="eager"
        decoding="async"
      />
      <img
        src={assetPath('/brand/almaburak-logo-horizontal.webp')}
        alt="Logotipo horizontal de Al-Maburak"
        class="brand-fusion__wordmark"
        width="1560"
        height="320"
        loading="eager"
        decoding="async"
      />
      <span class="brand-fusion__ember" aria-hidden="true"></span>
    </div>

    <h1 class="sr-only">{band.name}</h1>
  </div>

  <a href="#integrantes" class="scroll-cue" aria-label="Desplazarse hacia el contenido del presskit">
    <span class="scroll-cue__mouse" aria-hidden="true">
      <span class="scroll-cue__wheel"></span>
    </span>
    <span class="scroll-cue__arrow" aria-hidden="true"></span>
  </a>
</section>

---
import band from '../../content/band.json';
---
<section id="contacto" class="scene-section scene-section--contact relative overflow-hidden px-6 text-center">
  <div class="absolute inset-0 bg-radial-ember opacity-60"></div>
  <div class="relative mx-auto max-w-4xl">
    <p class="eyebrow">Contacto</p>
    <h2 class="cinematic-title mt-4 text-6xl md:text-8xl">Lleva a Al-Maburak al escenario</h2>
    <p class="mx-auto mt-8 max-w-2xl text-lg font-semibold uppercase tracking-[0.12em] text-smoke">Shows · Festivales · Prensa · Colaboraciones</p>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-smoke">Donde haya personas dispuestas a escuchar, ahí estaremos.</p>
    <a href={`mailto:${band.contactEmail}`} class="mt-10 inline-flex rounded-full bg-ember px-8 py-4 text-sm font-black uppercase tracking-[0.22em] text-white shadow-ember transition hover:scale-[1.03]">Enviar correo</a>
  </div>
</section>

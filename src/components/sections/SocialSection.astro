---
import social from '../../content/social.json';

const socialLogoSrc = `${import.meta.env.BASE_URL}images/brand/al-maburak-logo.webp`;

const icons: Record<string, string> = {
  spotify: '<circle cx="12" cy="12" r="9.75" fill="currentColor" /><path d="M7.15 9.26c3.18-.98 6.82-.72 9.68.82M7.75 12.1c2.58-.73 5.38-.5 7.66.82M8.27 14.72c1.96-.52 4.1-.33 5.78.67" fill="none" stroke="#080808" stroke-width="1.55" stroke-linecap="round" />',
  youtube: '<path d="M21.54 6.5a2.73 2.73 0 0 0-1.92-1.94C17.93 4.1 12 4.1 12 4.1s-5.93 0-7.62.46A2.73 2.73 0 0 0 2.46 6.5 28.5 28.5 0 0 0 2 12a28.5 28.5 0 0 0 .46 5.5 2.73 2.73 0 0 0 1.92 1.94c1.69.46 7.62.46 7.62.46s5.93 0 7.62-.46a2.73 2.73 0 0 0 1.92-1.94A28.5 28.5 0 0 0 22 12a28.5 28.5 0 0 0-.46-5.5ZM10 15.35v-6.7L15.5 12 10 15.35Z" />',
  instagram: '<path d="M7.8 2.75h8.4A5.06 5.06 0 0 1 21.25 7.8v8.4a5.06 5.06 0 0 1-5.05 5.05H7.8a5.06 5.06 0 0 1-5.05-5.05V7.8A5.06 5.06 0 0 1 7.8 2.75Zm8.4 16.68a3.24 3.24 0 0 0 3.23-3.23V7.8a3.24 3.24 0 0 0-3.23-3.23H7.8A3.24 3.24 0 0 0 4.57 7.8v8.4a3.24 3.24 0 0 0 3.23 3.23h8.4ZM12 7.25A4.75 4.75 0 1 1 7.25 12 4.75 4.75 0 0 1 12 7.25Zm0 7.68A2.93 2.93 0 1 0 9.07 12 2.93 2.93 0 0 0 12 14.93Zm4.95-8.52a1.11 1.11 0 1 1-1.11 1.11 1.11 1.11 0 0 1 1.11-1.11Z" />',
  facebook: '<path d="M14.2 8.15V6.6c0-.74.5-.91.86-.91h2.18V2.35l-3-.01c-3.33 0-4.09 2.49-4.09 4.08v1.73H7.76v3.75h2.39v9.75h4.05V11.9h2.72l.36-3.75H14.2Z" />',
  tiktok: '<path d="M17.16 6.28a5.35 5.35 0 0 0 3.15 1.02v3.24a8.58 8.58 0 0 1-3.15-.6v5.33a6.23 6.23 0 1 1-6.23-6.23c.36 0 .72.03 1.06.09v3.32a3 3 0 1 0 2.05 2.85V2.35h3.12v3.93Z" />'
};

const isExternal = (url: string) => Boolean(url && url !== '#');
---
<section id="redes" class="scene-section social-section bg-[#070707]">
  <div class="section-shell social-section__shell">
    <div class="social-section__intro">
      <p class="eyebrow social-section__eyebrow">Redes</p>
      <h2 class="cinematic-title social-section__title">Conecta con nosotros</h2>
      <span class="social-section__rule" aria-hidden="true"></span>
      <p class="social-section__copy">Síguenos en nuestras redes para ver lo que pasa dentro y fuera del escenario.</p>
    </div>

    <div class="social-section__grid" aria-label="Redes sociales de Al-Maburak">
      {social.map((item) => {
        const external = isExternal(item.url);
        return (
          <a
            href={external ? item.url : '#redes'}
            target={external ? '_blank' : undefined}
            rel={external ? 'noreferrer' : undefined}
            aria-disabled={external ? undefined : 'true'}
            class={`social-card social-card--${item.slug}${external ? '' : ' social-card--pending'}`}
          >
            <span class="social-card__backdrop" aria-hidden="true"></span>
            <span class="social-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img" focusable="false" set:html={icons[item.slug] ?? icons.instagram}></svg>
            </span>
            <span class="social-card__label">{item.label}</span>
            <span class="social-card__divider" aria-hidden="true"></span>
            <span class="social-card__description">{item.description}</span>
            <span class="social-card__cta">
              {item.cta}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        );
      })}
    </div>

    <div class="social-section__signature" aria-label="Al-Maburak">
      <img src={socialLogoSrc} alt="Al-Maburak" class="social-section__signature-logo" width="220" height="158" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

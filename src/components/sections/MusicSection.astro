---
import MusicCarousel from '../interactive/MusicCarousel';
---
<section id="musica" class="scene-section music-section">
  <div class="section-shell music-section__shell">
    <p class="eyebrow">Música</p>

    <div class="music-section__intro">
      <h2 class="cinematic-title music-section__title">Donde todo cobra vida</h2>
      <p class="music-section__lead">Nuestras historias terminaron convirtiéndose en canciones.</p>
    </div>

    <article class="music-feature" aria-label="Canción destacada de Al-Maburak">
      <div class="music-feature__copy">
        <p class="music-feature__label">Portada</p>
        <h3 class="music-feature__title">Nombre de la canción</h3>
        <p class="music-feature__lyrics">Letra: x</p>
        <p class="music-feature__links">
          <a href="https://open.spotify.com/" target="_blank" rel="noreferrer">Enlace a Spotify</a>
          <span aria-hidden="true">•</span>
          <a href="https://music.apple.com/" target="_blank" rel="noreferrer">Enlace a Apple Music</a>
          <span aria-hidden="true">•</span>
          <a href="#" aria-label="Enlace a otra plataforma de música">Enlace a otra plataforma de música</a>
        </p>
      </div>

      <MusicCarousel client:visible />
    </article>
  </div>
</section>

---
const moments = [
  ['2020', 'El inicio', 'Texto'],
  ['2021', 'Al Maburak', 'La historia del nombre.'],
  ['2021 – 2025', 'Nuestras canciones', 'Historia de nuestras canciones y qué tenemos que decir.'],
  ['Hoy', 'Seguimos adelante', 'El trabajo que estamos haciendo hoy en día.']
];
---
<section id="historia" class="scene-section scene-section--ember history-section relative overflow-hidden">
  <div class="absolute inset-0 bg-radial-ember opacity-50"></div>
  <div class="section-shell history-shell relative">
    <p class="eyebrow history-eyebrow">Historia</p>
    <h2 class="cinematic-title history-title">Nuestra historia</h2>

    <div class="history-timeline" aria-label="Línea de tiempo de Al-Maburak">
      {moments.map(([year, title, text]) => (
        <article class="history-timeline__item">
          <span class="history-timeline__dot" aria-hidden="true"></span>
          <div class="history-timeline__copy">
            <h3 class="history-timeline__heading">
              <span>{year}</span>
              <span aria-hidden="true"> · </span>
              <span>{title}</span>
            </h3>
            <p>{text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

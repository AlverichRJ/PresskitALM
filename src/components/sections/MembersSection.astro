    <h2 class="cinematic-title members-story-title mt-3">QUIÉNES SON AL-MABURAK</h2>

    <figure class="members-story-hero" aria-label="Espacio reservado para futura fotografía grupal de Al-Maburak">
      <div class="group-photo-placeholder">

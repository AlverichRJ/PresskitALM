---
import members from '../../content/members.json';
---
<section id="integrantes" class="scene-section bg-[#070707]">
  <div class="section-shell">
    <p class="eyebrow">Integrantes</p>
    <h2 class="cinematic-title mt-4 max-w-3xl text-6xl md:text-8xl">Presencia en escena</h2>

    <div class="members-stage mt-14" aria-label="Integrantes de Al-Maburak">
      {members.map((member, index) => (
        <article class="member-card" tabindex="0" style={`--member-index: ${index + 1}`}>
          <div class="member-card__thumb" aria-hidden="true">
            <img src={member.image} alt="" class="member-card__thumb-image" />
          </div>

          <div class="member-card__summary">
            <p class="member-card__role">{member.role}</p>
            <h3 class="member-card__name">{member.name}</h3>
            <p class="member-card__bio">{member.bio}</p>
          </div>

          <div class="member-spotlight" aria-hidden="true">
            <img src={member.image} alt="" class="member-spotlight__image" />
            <div class="member-spotlight__wash"></div>
            <div class="member-spotlight__content">
              <p class="member-spotlight__kicker">0{index + 1} / {member.role}</p>
              <h3 class="member-spotlight__name">{member.name}</h3>
              <p class="member-spotlight__bio">{member.bio}</p>
              <div class="member-spotlight__meta">
                <span>Perfil escénico</span>
                <p>Información destacada para medios, booking y presentación oficial dentro del presskit.</p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

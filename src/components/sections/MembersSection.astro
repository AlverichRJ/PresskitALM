---
import members from '../../content/members.json';
---
<section id="integrantes" class="bg-[#070707] py-28">
  <div class="section-shell">
    <p class="eyebrow">Integrantes</p>
    <h2 class="cinematic-title mt-4 max-w-3xl text-6xl md:text-8xl">Presencia en escena</h2>
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {members.map((member) => (
        <article class="group overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.03] shadow-2xl transition duration-500 hover:-translate-y-2 hover:border-ember/50">
          <img src={member.image} alt={`Retrato de ${member.name}`} class="aspect-[4/5] w-full object-cover opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-100" />
          <div class="p-6">
            <p class="text-sm font-bold uppercase tracking-[0.22em] text-ember">{member.role}</p>
            <h3 class="mt-2 font-display text-3xl uppercase">{member.name}</h3>
            <p class="mt-4 text-sm leading-6 text-smoke">{member.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

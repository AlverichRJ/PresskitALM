---
import members from '../../content/members.json';
---
<section id="integrantes" class="scene-section bg-[#070707]">
  <div class="section-shell">
    <p class="eyebrow">Integrantes</p>
    <h2 class="cinematic-title mt-4 max-w-3xl text-6xl md:text-8xl">Presencia en escena</h2>

    <div class="members-stage mt-14" aria-label="Integrantes de Al-Maburak">
      {members.map((member, index) => (
        <article class="member-card group" tabindex="0" style={`--member-index: ${index + 1}`}>
          <div class="member-card__glow" aria-hidden="true"></div>
          <div class="member-card__media">
            <img src={member.image} alt={`Retrato de ${member.name}`} class="member-card__image" />
            <div class="member-card__number" aria-hidden="true">0{index + 1}</div>
          </div>

          <div class="member-card__content">
            <p class="member-card__role">{member.role}</p>
            <h3 class="member-card__name">{member.name}</h3>
            <p class="member-card__bio">{member.bio}</p>

            <div class="member-card__reveal">
              <span class="member-card__line"></span>
              <p class="member-card__label">Perfil escénico</p>
              <p class="member-card__detail">Información destacada para medios, booking y presentación oficial dentro del presskit.</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

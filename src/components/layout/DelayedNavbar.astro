---
const sectionLinks = [
  { href: '#integrantes', label: 'Integrantes' },
  { href: '#historia', label: 'Historia' },
  { href: '#musica', label: 'Música' },
  { href: '#galeria', label: 'Galería' },
  { href: '#redes', label: 'Redes' },
  { href: '#contacto', label: 'Contacto' }
];
---
<header class="fixed left-0 right-0 top-0 z-50 translate-y-[-120%] opacity-0 transition-all duration-1000 ease-out" data-delayed-navbar>
  <nav class="site-navbar mx-auto mt-4 flex w-[min(1280px,calc(100%-2rem))] items-center justify-between rounded-full border border-white/10 bg-black/35 px-5 py-3 text-sm text-bone/85 shadow-2xl backdrop-blur-xl">
    <a href="#inicio" class="site-navbar__brand" aria-label="Ir al inicio de Al-Maburak">
      <img src="/images/brand/al-maburak-logo.webp" alt="Al-Maburak" class="site-navbar__logo" width="220" height="158" loading="eager" decoding="async" />
    </a>
    <div class="site-navbar__links hidden items-center md:flex" data-section-nav>
      {sectionLinks.map(({ href, label }) => (
        <a class="site-navbar__link transition hover:text-ember" href={href} data-section-link={href}>{label}</a>
      ))}
    </div>
  </nav>
</header>
<script>
  const navbar = document.querySelector('[data-delayed-navbar]');
  const reveal = () => navbar?.classList.remove('translate-y-[-120%]', 'opacity-0');

  const normalizeText = (text) => text?.replace(/\s+/g, ' ').trim() ?? '';

  const syncNavbarLabels = () => {
    document.querySelectorAll('[data-section-link]').forEach((link) => {
      const href = link.getAttribute('data-section-link');
      if (!href) return;

      const section = document.querySelector(href);
      const title = normalizeText(section?.querySelector('h1, h2')?.textContent);
      if (title) link.textContent = title;
    });
  };

  syncNavbarLabels();
  window.addEventListener('astro:page-load', syncNavbarLabels);
  window.setTimeout(reveal, 2200);
  window.addEventListener('scroll', reveal, { once: true });
</script>
